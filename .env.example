# Exemplo para hospedagem. Copie somente as variáveis necessárias para o provedor de deploy.
DATABASE_URL=jdbc:postgresql://localhost:5432/stowup
DATABASE_USERNAME=stowup
DATABASE_PASSWORD=troque-esta-senha
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
DATA_ENCRYPTION_KEY=gere-outro-segredo-longo-e-aleatorio
STOWUP_MASTER_ENABLED=true
STOWUP_MASTER_EMAIL=admin@seu-dominio.com
STOWUP_MASTER_PASSWORD=troque-esta-senha
STOWUP_PUBLIC_URL=https://api.seu-dominio.com

# Recuperação de senha
PASSWORD_RECOVERY_DELIVERY_MODE=live
PASSWORD_RECOVERY_EMAIL_FROM=nao-responda@seu-dominio.com
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USERNAME=seu-usuario
SMTP_PASSWORD=seu-segredo

# SMS opcional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Pagamentos opcionais
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
